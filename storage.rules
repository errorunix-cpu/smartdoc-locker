rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each user's files live in their own UID-scoped folder.
    match /users/{userId}/documents/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp');
      // Allow owner to delete existing files (delete has no request.resource).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
